{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KREYNIMA",
  "version": "0.0.0",
  "identifier": "com.buildwithdani.kreynima",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "KREYNIMA \u2014 Development",
        "width": 1100,
        "height": 760,
        "minWidth": 600,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false
  }
}
